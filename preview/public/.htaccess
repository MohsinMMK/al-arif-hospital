# Hostinger (Apache/LiteSpeed) server rules for the built site

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# One address for search engines: www goes to the bare domain
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# The site lives under /site
RewriteRule ^$ /site [L,R=301]

# Visit requests moved onto the Visit page; the query (a chosen service) carries over,
# placed before the #request fragment so the browser keeps it
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^site/request/?$ /site/visit?%1#request [L,R=301,NE]
RewriteRule ^site/request/?$ /site/visit#request [L,R=301,NE]

# Serve each route's prerendered HTML (built into /prerendered so no real folder shadows a route)
RewriteCond %{DOCUMENT_ROOT}/prerendered/$1/index.html -f
RewriteRule ^(site(?:/[^/]+)*)/?$ prerendered/$1/index.html [L]

# Anything else is missing: answer 404 (so search engines and AI agents don't take it for a real page)
# with the app, which shows its not-found page
ErrorDocument 404 /index.html

# The deploy action's file list lives in the web root; keep it private
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Hashed build assets never change; HTML must always revalidate
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^llms(-full)?\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>
